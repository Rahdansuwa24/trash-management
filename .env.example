# Server Configuration
PORT=3003
NODE_ENV=development
DOMAIN=trashmanage.duckdns.org

# Database Configuration (Laragon Lokal / TiDB Cloud Serverless)
# Untuk Laragon Lokal:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_trash
DB_SSL=false

# Untuk TiDB Cloud Serverless di Production:
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=your_tidb_user
# DB_PASSWORD=your_tidb_password
# DB_NAME=db_trash
# DB_SSL=true

# Autentikasi JWT
JWT_SECRET=trash-management-dev-secret-key-2026
JWT_EXPIRES_IN=7d

# Cloudflare R2 Object Storage (S3-Compatible)
# Dikosongkan saat dev lokal (menggunakan fallback URL)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=portfolio-assets
R2_PUBLIC_URL=https://assets.yourdomain.com
